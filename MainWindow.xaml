<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Бібліотека книг" FontSize ="26"
                   FontWeight="Bold" Margin="0, 0, 0, 20"/>

        <Grid Grid.Row ="1" Margin="0, 0, 0, 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Автор:"
                       VerticalAlignment="Center" Margin="0, 0, 10, 0"/>

            <ComboBox x:Name="cmbAuthors" Grid.Column="1" Width="220" Margin="0,0,10,0"
                      Height="32" VerticalContentAlignment="Center"
                      DisplayMemberPath="FullName"
                      SelectionChanged="CmbAuthors_SelectionChanged"/>

            <TextBlock Grid.Column="2" Text="Пошук:"
                       VerticalAlignment="Center" Margin="15, 0, 10, 0"/>

            <TextBox x:Name="txtSearch" Grid.Column="3"
                     Height="32" VerticalContentAlignment="Center"
                     Margin="0, 0, 10, 0"/>

            <Button Grid.Column="4" Content="Знайти"
                    Padding="15,5" Click="BtnSearch_Click"/>
        </Grid>

        <DataGrid x:Name="dgBooks" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF1F5F9">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Назва книги"
                                    Binding="{Binding Title}"
                                    Width="*"/>

                <DataGridTextColumn Header="Рік видання"
                                    Binding="{Binding Year}"
                                    Width="110"/>

                <DataGridTextColumn Header="Автор"
                                    Binding="{Binding Author.FullName}"
                                    Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name ="txtStatus" Grid.Row="3" 
                   Text="Завантаження..." Margin="0,12,0,0"
                   Foreground="DarkSlateGray" TextWrapping="Wrap"/>
    </Grid>
</Window>
